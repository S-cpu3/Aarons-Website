:root{
  --bg:#071026;
  --card:#0b1420;
  --accent:#7ee7c7;
  --accent-2:#6ea8fe;
  --muted:#9aa4b2;
  --radius:12px;
  --mono:"Segoe UI Mono","Courier New",monospace;
  color-scheme: dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial;color:#e6eef6;background:linear-gradient(180deg,var(--bg),#04101a);-webkit-font-smoothing:antialiased}
.container{max-width:960px;margin:0 auto;padding:28px}
.hero{padding:56px 0 32px;background:
  radial-gradient(600px 200px at 10% 10%, rgba(110,168,254,0.06), transparent 10%),
  radial-gradient(500px 180px at 90% 90%, rgba(126,231,199,0.05), transparent 10%);}
.hero .container{display:flex;flex-direction:column;gap:12px}
h1{font-size:2.2rem;margin:0;color:var(--accent)}
.subtitle{color:var(--accent-2);margin:2px 0 10px}
.links a{color:var(--muted);margin-right:14px;text-decoration:none}
.role{color:var(--muted);font-weight:600}
.card{background:linear-gradient(180deg,var(--card),rgba(255,255,255,0.01));padding:18px;border-radius:var(--radius);margin-top:18px;box-shadow:0 8px 30px rgba(2,6,23,0.6)}
.post{padding:10px 0;border-bottom:1px dashed rgba(255,255,255,0.03)}
.post:last-child{border-bottom:none}
.post h3{margin:0;font-size:1.05rem}
.meta{color:var(--muted);font-size:0.9rem;margin:6px 0}
.note{color:var(--muted);font-size:0.95rem}
.footer{padding:20px 0;color:var(--muted);text-align:center;font-size:0.9rem}
a{color:var(--accent);text-decoration:none}
code{background:rgba(255,255,255,0.02);padding:2px 6px;border-radius:6px;font-family:var(--mono);font-size:0.95rem}
@media (min-width:900px){
  .hero .container{flex-direction:row;align-items:center;justify-content:space-between}
}
