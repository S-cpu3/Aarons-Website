:root{
  --bg:#f6fbff;
  --page:#07102a;
  --card:#071433;
  --muted:#9fb0c9;
  --accent:#6ea8fe;
  --accent-2:#0072ff;
  --accent-3:#7ee7c7;
  --glass: rgba(255,255,255,0.03);
  --radius:14px;
  --mono:"Segoe UI Mono","Courier New",monospace;
  color-scheme: dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial;color:#eaf3ff;background:linear-gradient(180deg,#031027 0%, #07102a 60%);}
.container{max-width:1100px;margin:0 auto;padding:28px}
.hero{padding:48px 0;background:
  radial-gradient(600px 200px at 10% 10%, rgba(110,168,254,0.08), transparent 10%),
  radial-gradient(500px 180px at 90% 90%, rgba(126,231,199,0.06), transparent 10%);}
.hero-grid{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:center}
h1{font-size:2.4rem;margin:0;color:var(--accent-3);letter-spacing:0.6px}
.subtitle{color:var(--muted);margin:6px 0}
.lead{color:#dfeefe;max-width:52ch;margin:12px 0}
.links a{color:var(--muted);margin-right:14px;text-decoration:none;font-weight:600}
.cta{margin-top:18px;display:flex;gap:12px}
.btn{background:linear-gradient(90deg,var(--accent-2),var(--accent));color:#021025;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700}
.btn.ghost{background:transparent;border:1px solid rgba(255,255,255,0.06);color:var(--muted)}

.hero-right{display:flex;flex-direction:column;gap:16px;align-items:center}
.avatar{width:220px;height:220px;border-radius:18px;overflow:hidden;box-shadow:0 12px 40px rgba(6,20,40,0.6);background:linear-gradient(180deg,#062040, #042033);display:flex;align-items:center;justify-content:center}
.avatar-svg{width:100%;height:100%}
.quick-stats{display:flex;gap:12px;justify-content:space-between;width:100%;color:var(--muted);font-weight:700}
.quick-stats div{background:linear-gradient(180deg, rgba(110,168,254,0.06), rgba(126,231,199,0.03));padding:10px;border-radius:10px;text-align:center}

.layout{display:grid;grid-template-columns:1fr 280px;gap:28px;margin-top:18px}
main{min-width:0}
.sidebar{position:sticky;top:28px;align-self:start}
.card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));padding:20px;border-radius:var(--radius);margin-bottom:18px;box-shadow:0 8px 30px rgba(2,6,23,0.6)}
h2{color:var(--accent);margin-top:0}

.skills{display:flex;gap:12px;margin-top:12px}
.skill{flex:1;background:linear-gradient(180deg, rgba(110,168,254,0.03), rgba(126,231,199,0.02));padding:12px;border-radius:10px}
.skill h4{margin:0 0 6px 0;color:var(--accent-2)}

.featured-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;margin-top:12px}
.featured{padding:12px;border-radius:12px;background:linear-gradient(180deg, rgba(6,20,40,0.45), rgba(4,16,32,0.35));border:1px solid rgba(110,168,254,0.06)}
.featured h3{margin:0}
.meta{color:var(--muted);font-size:0.9rem;margin:6px 0}
.tags{margin-top:10px}
.tags span{display:inline-block;background:rgba(110,168,254,0.12);color:var(--accent-2);padding:6px 8px;border-radius:999px;margin-right:6px;font-size:0.85rem}

.timeline .event{display:flex;gap:12px;margin-top:12px}
.timeline .when{min-width:120px;color:var(--muted);font-weight:700}
.timeline .what{flex:1}

.project-list, .pub-list{margin:8px 0 0 18px}
.project-list li, .pub-list li{margin:8px 0}

.side-card{background:linear-gradient(180deg, rgba(110,168,254,0.02), rgba(126,231,199,0.01));padding:14px;border-radius:12px;margin-bottom:12px;color:var(--muted)}
.side-links a{display:block;color:var(--accent-2);text-decoration:none;margin:6px 0}

.footer{padding:28px 0;color:var(--muted);text-align:center;font-size:0.9rem;margin-top:28px}

a{color:var(--accent-3);text-decoration:none}
code{background:rgba(255,255,255,0.02);padding:2px 6px;border-radius:6px;font-family:var(--mono);font-size:0.95rem}

@media (max-width:980px){
  .hero-grid{grid-template-columns:1fr}
  .layout{grid-template-columns:1fr}
  .hero-right{flex-direction:row;justify-content:space-between}
}
